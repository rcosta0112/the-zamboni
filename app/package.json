{
  "name": "zamboni",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "prototypes/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev -w prototypes/0.0.2",
    "check": "npm run check --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "smoke": "npm run smoke -w prototypes/0.0.2",
    "probe": "npm run probe -w prototypes/0.0.2 --",
    "see-through": "npm run see-through -w prototypes/0.0.2",
    "export:ship": "npm run export:ship -w prototypes/0.0.2",
    "export:crew": "npm run export:crew -w prototypes/0.0.2",
    "export:player": "npm run export:player -w prototypes/0.0.2",
    "export:accept": "npm run export:accept -w prototypes/0.0.2 --",
    "rest-poses": "npm run rest-poses -w prototypes/0.0.2 --",
    "dev:0.0.1": "npm run dev -w prototypes/0.0.1",
    "smoke:0.0.1": "npm run smoke -w prototypes/0.0.1",
    "probe:0.0.1": "npm run probe -w prototypes/0.0.1 --",
    "see-through:0.0.1": "npm run see-through -w prototypes/0.0.1",
    "export:0.0.1:ship": "npm run export:ship -w prototypes/0.0.1",
    "export:0.0.1:crew": "npm run export:crew -w prototypes/0.0.1",
    "export:0.0.1:player": "npm run export:player -w prototypes/0.0.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.3"
  }
}
