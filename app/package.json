{
  "name": "zamboni",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "prototypes/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:01": "npm run dev -w prototypes/01-walk",
    "check": "npm run check --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "smoke": "node tools/smoke-01.mjs",
    "probe": "node tools/probe-01.mjs",
    "see-through": "node tools/probe-01.mjs tools/see-through-views.js --shots .export/see-through",
    "export:ship": "node tools/export.mjs ship",
    "export:crew": "node tools/export.mjs crew",
    "export:player": "node tools/export.mjs player"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.3"
  }
}
